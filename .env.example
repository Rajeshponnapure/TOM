# ═══════════════════════════════════════════════════════════════
# TOM (Technical Operations Manager) — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# cp .env.example .env
#
# Note on precedence: a variable already exported in your shell wins over this
# file (dotenv's standard behaviour). If a stale TOM_LLM_PROVIDER is left in an
# old terminal, TOM says so in the chat window instead of switching quietly.

# ── Long-term memory (Hindsight) ────────────────────────────────
# TOM remembers your corrections and preferences across sessions. By default this is
# stored on this machine (tom_brain/hindsight/memory.sqlite3) — nothing to configure.
# Opt in to Hindsight Cloud (https://ui.hindsight.vectorize.io) — both lines needed:
# HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
# HINDSIGHT_API_KEY=
# Or a self-hosted server (docker run ... ghcr.io/vectorize-io/hindsight):
# HINDSIGHT_BASE_URL=http://localhost:8888
# Optional: fixed memory bank id (default: tom-<random id> stored in tom_brain/hindsight/)
# HINDSIGHT_BANK_ID=
# Seconds before a memory call is abandoned (TOM carries on without it). Default 12
# HINDSIGHT_TIMEOUT_SECONDS=12
# Set to 0 to switch long-term memory off
# HINDSIGHT_ENABLED=1
# Folder for the local memory journal and offline retain queue (default: tom_brain/hindsight/)
# TOM_MEMORY_STATE_DIR=

# ── LLM provider ────────────────────────────────────────────────
# TOM runs on local Ollama by default: prompts never leave this machine.
# Hosted Groq is opt-in — it is used only when TOM_LLM_PROVIDER=groq is set
# (a GROQ_API_KEY on its own does nothing). Unset or misspelled = local.
# TOM_LLM_PROVIDER=groq
#
# No restart needed: the desktop header has a provider dropdown
# ("Groq (hosted)" / "Ollama (local)") that switches at runtime and writes
# this line for you. Each provider keeps its own model choice, via the
# GROQ_* and OLLAMA_* slots below.
#
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=
# GROQ_CODE_MODEL=
#
# Vision: only set this if your Groq account offers a multimodal model, e.g.
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Without it TOM answers image questions from local OCR and tells you why — it
# does not quietly call a local LLM while Groq is the active provider.
# GROQ_VISION_MODEL=
# NLP_PARSE_TIMEOUT_SECONDS=25

# ── Folder overrides ────────────────────────────────────────────
# Point a known folder somewhere else, e.g. a sandbox for demos:
# TOM_DOWNLOADS_DIR=
#
# Where TOM builds your deliverables (websites, code projects, documents, decks).
# Default: "<your Desktop>/TOM Workspace". Set this to build somewhere else.
# Naming an explicit path in a request (e.g. "build it in D:\Projects\Foo")
# always wins over this. TOM never builds inside its own install folder.
# TOM_WORKSPACE_DIR=

# ── AI / Ollama ─────────────────────────────────────────────────
# Ollama server URL (default: http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434
#
# On Groq these chat slots are ignored (GROQ_* is used instead), with ONE
# exception: the embedding slot below always runs locally, because Groq has no
# embeddings endpoint. That encoder indexes your RAG memory — it is not a chat
# model and never answers your prompts.

# Primary model for complex reasoning (default: gemma4:latest)
# OLLAMA_MODEL=gemma4:latest

# Fast model for simple tasks, parsing, chat (default: qwen2.5-coder:7b-instruct)
# OLLAMA_FAST_MODEL=qwen2.5-coder:7b-instruct

# Code generation model (default: qwen2.5-coder:7b-instruct)
# OLLAMA_CODE_MODEL=qwen2.5-coder:7b-instruct

# Embedding model for memory (default: nomic-embed-text:latest)
# OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# LLM timeout in seconds (default: 120)
# OLLAMA_TIMEOUT_SECONDS=120

# Task execution timeout in seconds (default: 180)
# TASK_TIMEOUT_SECONDS=180

# ── Email ────────────────────────────────────────────────────────
# Provider: "gmail" or "outlook" (default: gmail)
# EMAIL_PROVIDER=gmail

# Your email address
# EMAIL_ADDRESS=your.email@gmail.com

# App password (for Gmail: use an App Password from Google Account settings)
# EMAIL_PASSWORD=your_app_password_here

# IMAP server (default: imap.gmail.com)
# IMAP_HOST=imap.gmail.com

# IMAP port (default: 993)
# IMAP_PORT=993

# SMTP server (default: smtp.gmail.com)
# SMTP_SERVER=smtp.gmail.com

# SMTP port (default: 587; 465 uses implicit TLS)
# SMTP_PORT=587

# STARTTLS / TLS switches (default: true). Only turn off for a local relay.
# SMTP_STARTTLS=true
# IMAP_SSL=true

# Max emails to fetch from inbox (default: 10)
# EMAIL_INBOX_MAX_COUNT=10

# Enable auto-reply for important emails that ask for a reply (default: false).
# Never replies to no-reply/bot senders, answers each message once, at most one reply
# per sender per 24 h, and at most EMAIL_AUTO_REPLY_MAX_PER_RUN per check.
# EMAIL_AUTO_REPLY_ENABLED=false
# EMAIL_AUTO_REPLY_MAX_PER_RUN=5

# Email agent check interval in seconds (default: 300)
# EMAIL_CHECK_INTERVAL_SECONDS=300

# Reply timeout in seconds (default: 120)
# EMAIL_REPLY_TIMEOUT_SECONDS=120

# Open emails in client instead of inline (default: false)
# EMAIL_IMPORTANT_OPEN_IN_CLIENT=false

# Gmail OAuth credentials file path (default: google-credentials.json)
# GMAIL_CREDENTIALS_FILE=google-credentials.json

# Gmail OAuth token file path (default: google-credentials_token.json)
# GMAIL_TOKEN_FILE=google-credentials_token.json

# ── WhatsApp ─────────────────────────────────────────────────────
# auto (Desktop first on Windows, then Web), web (verified: reads the message back), desktop
# WHATSAPP_MODE=auto
# Names -> phone numbers (international format). A known number opens the exact chat, so
# nothing is searched and the wrong person can't be picked. Also read from data/whatsapp_contacts.json.
# WHATSAPP_CONTACTS={"Madhu": "+91 98765 43210", "Mom": "+1 415 555 0100"}

# ── Chat apps (sent through their official APIs, with approval) ──
# Slack: bot token with chat:write (+ users:read to message people by name)
# SLACK_BOT_TOKEN=xoxb-...
# Discord: channel webhooks (Channel Settings > Integrations > Webhooks). Webhooks can't DM people.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# DISCORD_WEBHOOKS={"dev": "https://discord.com/api/webhooks/..."}
# Telegram: bot token from @BotFather; chats must have started the bot
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHATS={"Ravi": 123456789, "team": "@teamchannel"}

# ── Instagram ────────────────────────────────────────────────────
# Chrome profile for Instagram automation
# INSTAGRAM_CHROME_PROFILE=Default

# Posts to extract per run (default: 20)
# INSTAGRAM_POSTS_PER_RUN=20

# Max scroll attempts (default: 5)
# INSTAGRAM_MAX_SCROLL_ATTEMPTS=5

# Scroll pause time in seconds (default: 3)
# INSTAGRAM_SCROLL_PAUSE_TIME=3

# Max carousel pages to process (default: 3)
# INSTAGRAM_MAX_CAROUSEL_PAGES=3

# Check interval in seconds (default: 10800 = 3 hours)
# INSTAGRAM_CHECK_INTERVAL_SECONDS=10800

# Auto-send report email (default: false)
# INSTAGRAM_AUTO_SEND_REPORT_EMAIL=false

# Enable video/audio capture from Instagram stories (default: false)
# INSTAGRAM_VIDEO_AUDIO_CAPTURE_ENABLED=false

# Video audio sample duration in seconds (default: 15)
# INSTAGRAM_VIDEO_AUDIO_SAMPLE_SECONDS=15

# ── Browser ──────────────────────────────────────────────────────
# Chrome executable path (default: C:/Program Files/Google/Chrome/Application/chrome.exe)
# CHROME_EXECUTABLE=C:/Program Files/Google/Chrome/Application/chrome.exe
# Run the automation browser (Web Auto / Auto-Debug) without a window
# TOM_BROWSER_HEADLESS=false

# Chrome user data directory (default: %LOCALAPPDATA%/Google/Chrome/User Data)
# CHROME_PROFILE_PATH=%LOCALAPPDATA%/Google/Chrome/User Data

# ── OCR / Screen Reading ─────────────────────────────────────────
# Tesseract OCR executable path (leave empty to use PATH)
# TESSERACT_CMD=

# ── Voice ────────────────────────────────────────────────────────
# Enable voice input (default: false)
# VOICE_INPUT_ENABLED=false

# Enable voice output (default: false)
# VOICE_OUTPUT_ENABLED=false

# Speech-to-text. "local" (default) = faster-whisper on this machine; "google" sends
# microphone audio to Google (cloud, opt-in; uses Indian English, en-IN).
# VOICE_RECOGNITION_ENGINE=local
# Local model name (in a faster-whisper/Hugging Face cache) or a model folder. TOM never
# downloads models: point TOM_ASR_MODEL_DIR at a cache that already has it.
# TOM_ASR_MODEL=large-v3-turbo
# TOM_ASR_MODEL_DIR=C:\voice-agent-data\cache\huggingface\hub
# "en" (default) or "auto" to detect the language
# TOM_ASR_LANGUAGE=en
# "auto" = GPU only when measured free VRAM covers the model + 1.5 GB reserve, else CPU
# TOM_ASR_DEVICE=auto
# TOM_ASR_VRAM_RESERVE_MB=1536
# Folder with CUDA 12 cuBLAS (default: found on PATH or in Ollama's install)
# TOM_CUDA_LIB_DIR=

# Text-to-speech. "local" (default) = Windows voices, English (India) preferred when
# installed (Settings > Time & language > Speech > Add voices); "edge" = Microsoft
# online neural voices (cloud, opt-in); "sapi" = the classic pyttsx3 voice.
# TOM_TTS_ENGINE=local
# Preferred local voices, comma-separated language tags or name parts, best first
# (default: en-US,Zira,Mark,David,en-IN — US English; Zira is the female US voice)
# TOM_TTS_VOICE=en-US
# Voice gender tried first: female (default) | male | any. With "female", a female voice of
# any preference beats a male one.
# TOM_TTS_GENDER=female
# Local speaking rate, 0.5-3.0 (default 1.15 = a little faster than the voice's normal pace)
# TOM_TTS_RATE=1.15
# Online voice when TOM_TTS_ENGINE=edge (default follows TOM_TTS_GENDER:
# en-US-JennyNeural female, en-US-GuyNeural male)
# TOM_VOICE=en-US-JennyNeural
# Online voice rate, e.g. +15% (default) / +0%
# TOM_VOICE_RATE=+15%

# Seconds to wait for you to START speaking after pressing Talk (default 7; push-to-talk uses 8)
# VOICE_LISTEN_TIMEOUT=7
# A request ends after this many seconds of quiet once you have spoken (default 2.5), or as soon
# as you press Talk again. Raise it if you pause for long while thinking.
# TOM_VOICE_END_SILENCE=2.5
# Longest single spoken request in seconds (default 60)
# TOM_VOICE_MAX_SECONDS=60

# VOICE_PHRASE_TIME_LIMIT, VOICE_PAUSE_THRESHOLD and VOICE_CALIBRATION_DURATION are no longer
# used (they cut requests off at the first 0.8 s pause / after 15 s); the recorder tracks the
# room's noise level itself. Use TOM_VOICE_END_SILENCE / TOM_VOICE_MAX_SECONDS above.

# Fallback (SAPI) voice: volume 0.0-1.0 and rate in words per minute (default 200)
# VOICE_VOLUME=1.0
# VOICE_RATE=200

# ── R6 resources ──
# TOM_LLM_ADMISSION=1            # 0 = skip the VRAM check before using a local model
# TOM_VRAM_RESERVE_MB=1024       # VRAM always left free (ASR, desktop)
# TOM_NUM_CTX=                   # force one context size for every request
# TOM_FALLBACK_MODEL=llama3.2:3b # used when the chosen model does not fit

# ── R9 advanced features (all off by default; see docs/security/r9-feature-review.md) ──
# TOM_WATCHERS=0                 # disk / RAM / blocked-task notices
# TOM_WATCH_DISK_FREE_GB=10
# TOM_WATCH_RAM_PCT=90
# TOM_WORKFLOWS=0                # save, review, approve and re-run plans
# TOM_CLOUD_ESCALATION=0         # also needs GROQ_API_KEY, TOM_CLOUD_DATA_POLICY, TOM_CLOUD_DAILY_LIMIT
# TOM_CLOUD_DATA_POLICY=no-personal-data
# TOM_CLOUD_DAILY_LIMIT=0

# ── Voice & models ──
# TOM_WAKE_WORD=hey tom          # hands-free mode only acts on speech that starts with this (off when empty)
# TOM_OLLAMA_KEEP_ALIVE=5m       # unload an idle local model after this long (Ollama default 5m; 0 = at once)
