# ═══════════════════════════════════════════════════════════════
# TOM (Technical Operations Manager) — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# cp .env.example .env

# ── AI / Ollama ─────────────────────────────────────────────────
# Ollama server URL (default: http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# Primary model for complex reasoning (default: gemma4:latest)
# OLLAMA_MODEL=gemma4:latest

# Fast model for simple tasks, parsing, chat (default: qwen2.5-coder:7b-instruct)
# OLLAMA_FAST_MODEL=qwen2.5-coder:7b-instruct

# Code generation model (default: qwen2.5-coder:7b-instruct)
# OLLAMA_CODE_MODEL=qwen2.5-coder:7b-instruct

# Embedding model for memory (default: nomic-embed-text:latest)
# OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# LLM timeout in seconds (default: 120)
# OLLAMA_TIMEOUT_SECONDS=120

# Task execution timeout in seconds (default: 180)
# TASK_TIMEOUT_SECONDS=180

# ── Email ────────────────────────────────────────────────────────
# Provider: "gmail" or "outlook" (default: gmail)
# EMAIL_PROVIDER=gmail

# Your email address
# EMAIL_ADDRESS=your.email@gmail.com

# App password (for Gmail: use an App Password from Google Account settings)
# EMAIL_PASSWORD=your_app_password_here

# IMAP server (default: imap.gmail.com)
# IMAP_HOST=imap.gmail.com

# IMAP port (default: 993)
# IMAP_PORT=993

# SMTP server (default: smtp.gmail.com)
# SMTP_SERVER=smtp.gmail.com

# SMTP port (default: 587)
# SMTP_PORT=587

# Max emails to fetch from inbox (default: 10)
# EMAIL_INBOX_MAX_COUNT=10

# Enable auto-reply for important emails (default: false)
# EMAIL_AUTO_REPLY_ENABLED=false

# Email agent check interval in seconds (default: 300)
# EMAIL_CHECK_INTERVAL_SECONDS=300

# Reply timeout in seconds (default: 120)
# EMAIL_REPLY_TIMEOUT_SECONDS=120

# Open emails in client instead of inline (default: false)
# EMAIL_IMPORTANT_OPEN_IN_CLIENT=false

# Gmail OAuth credentials file path (default: google-credentials.json)
# GMAIL_CREDENTIALS_FILE=google-credentials.json

# Gmail OAuth token file path (default: google-credentials_token.json)
# GMAIL_TOKEN_FILE=google-credentials_token.json

# ── Instagram ────────────────────────────────────────────────────
# Chrome profile for Instagram automation
# INSTAGRAM_CHROME_PROFILE=Default

# Posts to extract per run (default: 20)
# INSTAGRAM_POSTS_PER_RUN=20

# Max scroll attempts (default: 5)
# INSTAGRAM_MAX_SCROLL_ATTEMPTS=5

# Scroll pause time in seconds (default: 3)
# INSTAGRAM_SCROLL_PAUSE_TIME=3

# Max carousel pages to process (default: 3)
# INSTAGRAM_MAX_CAROUSEL_PAGES=3

# Check interval in seconds (default: 10800 = 3 hours)
# INSTAGRAM_CHECK_INTERVAL_SECONDS=10800

# Auto-send report email (default: false)
# INSTAGRAM_AUTO_SEND_REPORT_EMAIL=false

# Enable video/audio capture from Instagram stories (default: false)
# INSTAGRAM_VIDEO_AUDIO_CAPTURE_ENABLED=false

# Video audio sample duration in seconds (default: 15)
# INSTAGRAM_VIDEO_AUDIO_SAMPLE_SECONDS=15

# ── Browser ──────────────────────────────────────────────────────
# Chrome executable path (default: C:/Program Files/Google/Chrome/Application/chrome.exe)
# CHROME_EXECUTABLE=C:/Program Files/Google/Chrome/Application/chrome.exe

# Chrome user data directory (default: %LOCALAPPDATA%/Google/Chrome/User Data)
# CHROME_PROFILE_PATH=%LOCALAPPDATA%/Google/Chrome/User Data

# ── OCR / Screen Reading ─────────────────────────────────────────
# Tesseract OCR executable path (leave empty to use PATH)
# TESSERACT_CMD=

# ── Voice ────────────────────────────────────────────────────────
# Enable voice input (default: false)
# VOICE_INPUT_ENABLED=false

# Enable voice output (default: false)
# VOICE_OUTPUT_ENABLED=false

# TOM voice character (e.g., "default", "whisper", "echo")
# TOM_VOICE=default

# Speech rate (default: 180)
# TOM_VOICE_RATE=180

# Voice recognition engine: "google" or "sphinx" (default: google)
# VOICE_RECOGNITION_ENGINE=google

# Listen timeout in seconds (default: 5)
# VOICE_LISTEN_TIMEOUT=5

# Phrase time limit in seconds (default: 10)
# VOICE_PHRASE_TIME_LIMIT=10

# Energy threshold for voice detection (default: 300)
# VOICE_ENERGY_THRESHOLD=300

# Pause threshold in seconds (default: 0.8)
# VOICE_PAUSE_THRESHOLD=0.8

# Calibration duration in seconds (default: 2)
# VOICE_CALIBRATION_DURATION=2

# Voice output volume (0.0 to 1.0, default: 1.0)
# VOICE_VOLUME=1.0

# Voice output rate (words per minute, default: 180)
# VOICE_RATE=180
